# Local development only. Copy to .env and pick your own password:
#   cp .env.example .env
# Never use these values outside your machine.

# PostgreSQL superuser created by docker compose.
AGNUSMAIL_DB_USER=agnusmail
AGNUSMAIL_DB_PASSWORD=change-me
AGNUSMAIL_DB_NAME=agnusmail

# Used when you run the API, worker or tests from your host with `uv run`.
# The containers build their own URLs from the three values above.
AGNUSMAIL_DATABASE_URL=postgresql+psycopg://agnusmail:change-me@127.0.0.1:5432/agnusmail
AGNUSMAIL_REDIS_URL=redis://127.0.0.1:6379/0
